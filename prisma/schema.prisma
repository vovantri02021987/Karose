generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
}

enum VoucherScope {
  ORDER
  PRODUCT
}

enum ChatRole {
  USER
  ASSISTANT
}

enum PaymentMethod {
  COD
  VIETQR
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  phone        String?  @unique
  passwordHash String?
  role         Role     @default(CUSTOMER)
  orders       Order[]
  reviews      Review[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String
  description      String           @db.Text
  ingredientsInci  String           @db.Text
  usageGuide       String           @db.Text
  storageGuide     String?
  skinTypes        String[]
  benefits         String[]
  images           String[]
  isFeatured       Boolean          @default(false)
  isActive         Boolean          @default(true)
  isCombo          Boolean          @default(false)
  /// Khung giao hàng chuẩn (ngày làm việc). Khu vực điều chỉnh theo quy tắc trong src/lib/delivery.ts.
  deliveryMinDays  Int              @default(2)
  deliveryMaxDays  Int              @default(4)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  comboItems       ComboItem[]      @relation("ComboParent")
  reviews          Review[]
  voucherProducts  VoucherProduct[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductVariant {
  id             String           @id @default(cuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String           @unique
  name           String
  price          Int
  compareAtPrice Int?
  weightGram     Int              @default(200)
  batches        InventoryBatch[]
  orderItems     OrderItem[]
  includedIn     ComboItem[]      @relation("ComboChild")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ComboItem {
  id             String         @id @default(cuid())
  comboProductId String
  comboProduct   Product        @relation("ComboParent", fields: [comboProductId], references: [id], onDelete: Cascade)
  childVariantId String
  childVariant   ProductVariant @relation("ComboChild", fields: [childVariantId], references: [id])
  quantity       Int            @default(1)
}

model InventoryBatch {
  id                String         @id @default(cuid())
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchCode         String
  manufacturedDate  DateTime
  expiryDate        DateTime
  initialQuantity   Int
  availableQuantity Int
  reservedQuantity  Int            @default(0)
  createdAt         DateTime       @default(now())

  @@index([variantId, expiryDate])
}

model Voucher {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String?
  discountType   String
  discountValue  Int
  minOrderAmount Int      @default(0)
  maxDiscount    Int?
  usageLimit     Int?
  usedCount      Int      @default(0)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  /// ORDER: giảm trên toàn đơn. PRODUCT: chỉ giảm trên tiền hàng của các sản phẩm trong `products`.
  scope          VoucherScope @default(ORDER)
  products       VoucherProduct[]
  orders         Order[]
}

model VoucherProduct {
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([voucherId, productId])
  @@index([productId])
}

model Order {
  id              String        @id @default(cuid())
  orderCode       String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String
  province        String
  district        String
  ward            String
  note            String?
  subtotal        Int
  shippingFee     Int
  discountAmount  Int           @default(0)
  /// Cam kết giao hàng chốt tại thời điểm đặt (ngày làm việc), theo tỉnh/thành và sản phẩm trong đơn.
  deliveryMinDays Int?
  deliveryMaxDays Int?
  estimatedDeliveryText String?
  totalAmount     Int
  voucherId       String?
  voucher         Voucher?      @relation(fields: [voucherId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentRef      String?
  trackingCode    String?
  shippingPartner String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPrice      Int
  batchAllocated Json?
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String
  rating     Int
  comment    String   @db.Text
  images     String[]
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/// Hội thoại chatbot tư vấn (ẩn danh, không gắn tài khoản).
model ChatSession {
  id        String        @id @default(cuid())
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String      @db.Text
  intent    String?
  /// ASSISTANT: { productSlugs, sources, usedWebUpdate } để hiểu câu hỏi nối tiếp.
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

/// Kiến thức tham khảo đồng bộ từ internet. KHÔNG bao giờ chứa/ghi đè giá, tồn kho của KaRose.
model KnowledgeSource {
  id        String   @id @default(cuid())
  title     String
  sourceUrl String   @unique
  summary   String   @db.Text
  category  String   @default("INGREDIENT")
  syncedAt  DateTime @default(now())
  isActive  Boolean  @default(true)

  @@index([category, isActive])
}
