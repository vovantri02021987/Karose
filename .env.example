# PostgreSQL (Neon/Supabase: dùng pooled connection string khi deploy serverless)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karose?schema=public"

# Mật khẩu tài khoản seed (tuỳ chọn, có mặc định)
SEED_ADMIN_PASSWORD="Admin@123456"
SEED_STAFF_PASSWORD="Staff@123456"

# VietQR — tài khoản nhận tiền (img.vietqr.io). BANK_ID là mã/BIN ngân hàng, vd: 970436 (Vietcombank) hoặc VCB
VIETQR_BANK_ID="970436"
VIETQR_ACCOUNT_NO="0123456789"
VIETQR_ACCOUNT_NAME="CONG TY KAROSE"
# Webhook ngân hàng gọi kèm header: Authorization: Bearer <VIETQR_WEBHOOK_SECRET>
VIETQR_WEBHOOK_SECRET="doi-thanh-chuoi-bi-mat-dai-ngau-nhien"
